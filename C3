set ns [new Simulator]

#Trace files

set mytrace [open example3.tr w]

Sns trace-all $mytrace

set myNAM [open example3.nam w]

$ns namtrace-all $myNAM

#Create nodes

set no [Sns node]

$n0 color "magenta"

Sn0 label "src1"

set nl [Sns node]

set n2 [$ns node]

Sn2 color "magenta"

Sn2 label "src2"

set n3 [Sns node]

Sn3 color "blue"

Sn3 label "dest2"

set n4 [Sns node]

set n5 [Sns node]

$n5 color "blue"

$n5 label "dest1"

# Create LAN

$ns make-lan "$n0 $n1 $n2 $n3 $n4" 100Mb 100ms LL Queue/DropTail Mac/802_3

#Link from LAN to destination node

Sns duplex-link $n4 $n5 1Mb 1ms DropTail

#TCP connection 1: n0-> n5

set tcp0 [new Agent/TCP] Sns attach-agent $n0 $tcp0 set ftp0 [new Application/FTP] $ftp0 attach-agent $tcp0 $ftp0 set packetSize_ 500 Sftp0 set interval_0.0001 set sink5 [new Agent/TCPSink] Sns attach-agent $n5 $sink5 Sns connect Stcp0 $sink5 #

#TCP connection 2: n2 -> n3

set tcp2 [new Agent/TCP] $ns attach-agent $n2 $tcp2 set ftp2 [new Application/FTP] $ftp2 attach-agent Stcp2 $ftp2 set packetSize_ 600 Sftp2 set interval_ 0.001 set sink3 [new Agent/TCPSink] Sns attach-agent $n3 $sink3 Sns connect Stcp2 $sink3

#TCP trace files

#-

set file1 [open file1.tr w]

Stcp0 attach $file1

set file2 [open file2.tr w]

Stcp2 attach $file2

#Trace congestion window

Stcp0 trace cwnd

$tcp2 trace cwnd_

#

# Finish procedure

proc finish {} {

global ns mytrace myNAM

Sns flush-trace

close Smytrace

close $myNAM

exec nam example3.nam &

#Schedule FTP traffic

Sns at 0.1 "Sftp0 start"

Sns at 5.0 "Sftp0 stop"

$ns at 7.0 "$ftp0 start"

Sns at 14.0 "$ftp0 stop"

$ns at 0.2 "$ftp2 start"

Sns at 8.2 "Sftp2 stop"

Sns at 10.0 "$ftp2 start"

Sns at 15.0 "$ftp2 stop

#Finish simulation

Sns at 16.0 "finish"

#Run simulation

Sns run
